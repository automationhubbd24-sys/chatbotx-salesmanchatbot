# ─── salesmanChatbot API ────────────────────────────────────────────────────────────

# Workspace token — found in salesmanChatbot Settings → Developer → API Keys
# Used for stdio transport. For SSE, pass via ?workspace_token= query param instead.
SALESMANCHATBOT_API_KEY=

# API base URL of your salesmanChatbot instance (e.g. https://app.salesmanchatbot.io/api)
# The MCP server fetches the OpenAPI spec from {SALESMANCHATBOT_API_URL}/public-spec.json
SALESMANCHATBOT_API_URL=

# Set to "true" to disable TLS certificate verification.
# Only use in local development with self-signed certificates.
SALESMANCHATBOT_ALLOW_SELF_SIGNED_CERT=

# How long the fetched OpenAPI spec (and its derived tool list) is trusted
# before the next tools/list call triggers a background re-fetch, in ms.
SALESMANCHATBOT_SPEC_TTL_MS=300000

# Maximum duration for an OpenAPI, token introspection, or tool call HTTP request, in ms.
SALESMANCHATBOT_HTTP_TIMEOUT_MS=30000

# ─── MCP Server (SSE / HTTP transport only) ──────────────────────────────────

# Transport mode: "stdio" | "sse" | "both"
# - stdio: Claude spawns the process directly (recommended for local use)
# - sse:   Run as an HTTP server — clients connect via URL
# - both:  Run stdio and SSE simultaneously
SALESMANCHATBOT_MCP_TRANSPORT=sse

# Host the SSE server listens on (use 127.0.0.1 for local, 0.0.0.0 for public)
SALESMANCHATBOT_MCP_HOST=127.0.0.1

# Port the SSE server listens on
SALESMANCHATBOT_MCP_PORT=3333

# URL path for the SSE endpoint
SALESMANCHATBOT_MCP_SSE_PATH=/sse

# URL path for the JSON-RPC messages endpoint
SALESMANCHATBOT_MCP_MESSAGES_PATH=/messages

# CORS origin allowed to call the SSE/HTTP endpoints (e.g. https://chat.openai.com).
# "*" allows any origin — fine for local development, tighten for a public deployment.
SALESMANCHATBOT_MCP_CORS_ORIGIN=*

# ─── Server identity (sent to AI clients on connect) ─────────────────────────

# Display name shown to AI clients (e.g. Claude, ChatGPT).
# Defaults to the package name if not set.
SALESMANCHATBOT_MCP_SERVER_NAME=salesmanChatbot MCP Server

# Optional override for the default MCP workflow instructions.
# Leave unset to receive future server guidance updates; set only for a deliberate
# deployment-specific policy.
# SALESMANCHATBOT_MCP_SERVER_INSTRUCTIONS=
